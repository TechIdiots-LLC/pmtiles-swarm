{
  "port": 8090,
  "adminPort": 8091,
  "adminHost": "127.0.0.1",

  "dataDir": "/var/lib/pmtiles-swarm/data",
  "savePath": "/EDIT-ME/store/torrent-data",
  "savePathLayout": "infohash",

  "engine": "libtorrent",
  "secondaryEngines": ["webtorrent"],
  "libtorrent": {
    "python": "python3",
    "resumeDir": "/var/lib/pmtiles-swarm/data/resume",
    "listen": "0.0.0.0:6881",
    "upnp": true,
    "natpmp": true
  },
  "webtorrent": {
    "clientOptions": { "torrentPort": 6882 }
  },

  "torrentFormat": "hybrid",
  "pieceLength": 4194304,
  "maxConnections": 100,
  "trackers": [
    "udp://tracker.opentrackr.org:1337/announce",
    "udp://tracker.torrent.eu.org:451/announce",
    "udp://tracker-udp.gbitt.info:80/announce",
    "wss://tracker.openwebtorrent.com",
    "wss://tracker.webtorrent.dev"
  ],

  "feedTitle": "Example map archives",
  "feedCopyright": "© OpenStreetMap contributors",

  "watch": [
    {
      "path": "/EDIT-ME/store/generated/pmtiles",
      "categories": ["basemaps"],
      "pollSeconds": 0,
      "keepDays": 35
    }
  ],

  "auth": {
    "username": "admin",
    "password": "REPLACE-ME",
    "apiKey": "REPLACE-WITH-A-LONG-RANDOM-STRING",
    "tokens": []
  }
}
